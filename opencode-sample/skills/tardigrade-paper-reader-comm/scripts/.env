# paper_comm.py 读取的配置（本地开发默认值，生产请替换成真实密钥）

# ---- 传输层身份：服务端 AGENT_SECRETS 里该 agent 的密钥，不是数据授权 ----
PAPER_COMM_AGENT_ID=research-agent-v1
PAPER_COMM_API_KEY=tardigrade-1314-001

# ---- 数据授权：账号 transfer key（ptk_…），在 tardigrade 网页「导出 → 🔑 转交 Key」生成 ----
# 通信服务在入口校验它并盖章归属账号；缺失 / 已删除 / 账号注销都会 403。
# 注意：不要把它填到 PAPER_COMM_API_KEY 里（那是 X-Api-Key，会 401）。
PAPER_COMM_TRANSFER_KEY=xxx

# 旧的 tk:v2 与 KEY_HASH_PEPPER 已不再参与鉴权，别在这里配。
