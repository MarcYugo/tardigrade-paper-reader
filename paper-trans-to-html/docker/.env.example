# 复制为 .env 后按需修改：cp .env.example .env
# 这些值会覆盖 docker-compose.yml 里的默认值（MONGO_APP_* 仍从 mongo_configuration/.env 继承）

# 宿主机映射端口（只绑 127.0.0.1，外网访问不到）
APP_PORT=8000

# MongoDB 位置：默认连 compose 网络里的服务名 mongo
# 用外部/云端数据库时直接给整串（优先级最高）：
# MONGO_URI=mongodb://user:pass@host:27017/paper?authSource=admin
# MONGO_HOST=mongo
# MONGO_PORT=27017

# 存储后端：auto（连不上回退本地 JSON）/ mongo（连不上就启动失败）/ json
APP_STORAGE=auto

# 是否允许未登录自助注册（要暴露到公网建议设 0）
ALLOW_SIGNUP=1

# 安装级默认 LLM（可选；每个账号还能在网页「⚙ 设置 → LLM 服务」里各自覆盖）
# DEEPSEEK_API_KEY=sk-xxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# PDF 解析（OCR）后端：**留空 / 不写 = 用网页「⚙ 设置」里保存的值**（可随时切换）
# 填 surya / unlimited_ocr = 强制锁定该后端（会覆盖网页里的选择，页面上会提示）
# auto / pymupdf 使用本地 PyMuPDF 链路；surya / unlimited_ocr 使用对应的整页 OCR 链路
# PDF_PARSER_BACKEND=

# Unlimited-OCR 整页 OCR 推理服务（vLLM 的 OpenAI 兼容接口；backend=unlimited_ocr 时使用）
# UNLIMITED_OCR_URL=http://host.docker.internal:9010/v1
# UNLIMITED_OCR_MODEL=Unlimited-OCR
# 单页请求超时（秒）
# UNLIMITED_OCR_TIMEOUT=600
# 服务端设了 VLLM_API_KEY 才需要
# UNLIMITED_OCR_API_KEY=
# 数据来源路由：auto(默认，本地不可用就自动改用百度智能云在线解析) / local / online
# 注意：走在线解析时容器要能访问公网（aip.baidubce.com），按页计费
# UNLIMITED_OCR_ROUTE=auto
# 在线解析（百度智能云）凭据：一般写在 config.json 的 parser 段
# （unlimited_ocr_online_api_key / unlimited_ocr_online_secret_key）；这里可覆盖
# UNLIMITED_OCR_ONLINE_API_KEY=
# UNLIMITED_OCR_ONLINE_SECRET_KEY=

# PaddleOCR-VL 地址（已删除：旧客户端与配对链路已随代码移除，这两个变量不再被读取，
# 仅作历史记录保留）
# PADDLE_OCR_URL=http://host.docker.internal:8080/v1
# PADDLE_OCR_MODEL=PaddleOCR-VL-1.6-0.9B

# ---- 容器内存（不填 = 不限制，可用满宿主机内存；改了要 `docker compose up -d` 生效）----
# MEM_LIMIT=10g        硬上限（超过被 OOM 杀；解析大 PDF 建议不低于 4g）
# MEM_RESERVATION=2g   软保障（仅调度预留，不限制使用）
# MEMSWAP_LIMIT=12g    上限+swap 总配额；= MEM_LIMIT 即禁用 swap；-1 = 不限
# SHM_SIZE=512m        /dev/shm 大小（默认 64m，PDF 位图渲染容易撞上限）
# 查看是否被 OOM 杀：docker inspect paper-app --format '{{.State.OOMKilled}}'
