    "local_max_figures": 24,
    "local_use_vector_figures": false,
    "surya_url": "http://127.0.0.1:8060/v1",
    "surya_backend": "llamacpp",
    "unlimited_ocr_url": "http://127.0.0.1:9010/v1",
    "unlimited_ocr_model": "Unlimited-OCR",
    "unlimited_ocr_timeout": 600,
    "unlimited_ocr_api_key": "",
    "unlimited_ocr_route": "auto",
    "unlimited_ocr_online_api_key": "",
    "unlimited_ocr_online_secret_key": "",
    "dpi": 150,
    "image_dpi": 300,
    "image_labels": ["Picture", "Figure", "Diagram", "ChemicalBlock"],
    "image_pad": 4,
    "min_image_size": 32,
    "keep_html": true,
    "fallback": true,
    "drop_text_in_images": true,
    "text_in_image_overlap": 0.6
