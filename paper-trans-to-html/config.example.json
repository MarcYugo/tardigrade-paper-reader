{
  "backend": "deepseek",
  "deepseek_api_key": "",
  "deepseek_base_url": "https://api.deepseek.com",
  "deepseek_model": "deepseek-flash",

  "parser": {
    "backend": "auto",
    "local_device": "",
    "local_dpi": 300,
    "local_padding": 2.0,
    "local_temperature": 0.0,
    "local_max_tokens": 384,
