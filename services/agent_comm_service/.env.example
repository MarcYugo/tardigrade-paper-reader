HOST=0.0.0.0
PORT=8090
# Redis 访问口令：compose 会用 `--requirepass` 注入，并把它拼进 `REDIS_URL`。
# 生产务必改成随机值；宿主机上的 reader 也要拿到同一个口令。
REDIS_PASSWORD=paper-redis-dev
REDIS_URL=redis://:paper-redis-dev@127.0.0.1:6379/0

# 流与消费组
STREAM_IN_RAW=outside-in-raw
STREAM_IN=outside-in-stream
STREAM_OUT=inside-out-stream
GROUP_GUARD=guard-workers
GROUP_READER=outside-in-workers
GROUP_DISPATCH=inside-out-dispatchers

# TTL
REQUEST_TTL=3600
REPLY_TTL=3600
WAITER_GRACE=60
DEFAULT_TIMEOUT_S=180
MAX_TIMEOUT_S=1800

# 完整结果（超出单条回包上限的大 JSON 存 agent:result:{rid}）
RESULT_TTL=3600                 # 完整结果存活秒数（GET /v1/requests/{id}/result）
RESULT_MAX_MB=16                # 单条完整结果上限
RESULT_COMPRESS_KB=32           # 超过该大小用 gzip+base64 存
RESULT_DELETE_ON_FETCH=0        # 1=取回即删（也可单次用 ?purge=true）；0=只靠 TTL 过期

# 并发
WORKER_CONCURRENCY=16
READ_BATCH=16
BLOCK_MS=200
RECLAIM_IDLE_MS=60000
RECLAIM_INTERVAL_S=60

# 限额
MAX_INLINE_KB=64
MAX_PAYLOAD_DEPTH=8
QUOTA_QPS=20

# 鉴权（键 = agent_id，值 = 该 agent 的密钥；调用方用 X-Agent-Id + X-Api-Key 自报）
# ⚠️ compose 里是 `${AGENT_SECRETS:?}`：不设会直接拒绝启动，避免静默降级成“不鉴权”。
# ⚠️ 改这里必须重启本服务（docker compose up -d）；客户端（skill 的 PAPER_COMM_API_KEY）要跟它一致。
AGENT_SECRETS={"research-agent-v1":"tardigrade-1314-001"}
REQUIRE_SIGNATURE=0
TS_WINDOW=300

# transfer_key（旧模型：只存不可逆摘要，没有“解密密钥”）
# ⚠️ 新模型下访问权只来自「账号 transfer key（ptk_…）」，这条路径默认关闭，
#    仅在 ALLOW_ENV_TRANSFER_KEYS=1 时用于兼容旧脚本。
KEY_HASH_PEPPER=change-me-pepper        # 生产务必覆盖；换掉后已发 key 全部失效
KEY_DEFAULT_TTL=86400                   # 默认有效期（秒）
KEY_MAX_TTL=7776000                     # 上限 90 天

# ===== 准入：账号 transfer key（ptk_…）=====
# 网关直读 tardigrade 应用那套集合完成校验，校验结果以「盖章」随消息下发。
ACCOUNT_KEY_REQUIRED=1                  # 1=每个请求必须带账号 key；0=仅本地调试
ALLOW_ENV_TRANSFER_KEYS=0               # 1=兼容旧的 tk:v2（pepper 派生，与账号无关）
ACCOUNT_KEY_PREFIX=ptk_
ACCOUNT_KEY_COLLECTION=transfer_keys    # 应用「转交 Key」集合（_id=用户名小写，keys[] 明文）
USER_COLLECTION=users                   # 确认账号是否已注销
GATEWAY_META_COLLECTION=agent_gateway_meta   # 盖章密钥持久化位置（自动生成，勿删）
AUTH_STAMP_SECRET=                      # 留空=Mongo 里 get-or-create 一份（跨重启稳定）
STAMP_WINDOW=3600                       # 盖章有效期（秒）
REQUIRE_READER_SIG=1                    # 回包必须带 reader 签名（HMAC），否则进 DLQ

# 密钥存储：复用 mongo_configuration/ 的单机实例（业务账号 paper，仅 paper 库 readWrite）
# 宿主机本地跑用 127.0.0.1；容器内用服务名 mongo:27017（同 paper-mongo-net 网络）
# 想不依赖 Mongo 可设 MONGO_URL=memory://（进程内存，重启即失效）
MONGO_URL=mongodb://paper:paper123@127.0.0.1:27017/paper?authSource=paper
MONGO_DB=paper
KEY_COLLECTION=agent_transfer_keys

# 意图白名单
ALLOWED_INTENTS=paper.insight.validate,paper.section.query,paper.note.export,paper.note.list
