# 复制成 .env 后按需修改；docker compose 会自动读取同目录的 .env
# 服务端口（只映射到宿主机回环）
SANDBOX_PORT=8090

# 鉴权：留空 = 不校验；对外暴露时务必设置，并在请求头里带 X-API-Key
SANDBOX_API_KEY=

# 并发 / 超时
SANDBOX_MAX_CONCURRENCY=2
SANDBOX_QUEUE_TIMEOUT=30
SANDBOX_DEFAULT_TIMEOUT=20
SANDBOX_MAX_TIMEOUT=60

# 出图 DPI
SANDBOX_FIGURE_DPI=150

# 排障：设为 1 保留 /tmp/sandbox/<run_id>/（记得手动清）
SANDBOX_KEEP_WORKDIR=0
